{
  "manifest_version": 3,
  "name": "Google Fast Account Switcher",
  "version": "1.0.0",
  "description": "Chuyển nhanh tài khoản Google (/u/0, /u/1...) bằng phím tắt hoặc popup.",
  "browser_specific_settings": {
    "gecko": {
      "id": "fast-google-account-switcher@khanhnkq.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "tabs",
    "activeTab"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_icon": "icon.svg",
    "default_title": "Google Fast Switcher",
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "commands": {
    "switch-to-0": {
      "suggested_key": {
        "default": "Alt+Shift+1"
      },
      "description": "Chuyển sang Account 0 (/u/0)"
    },
    "switch-to-1": {
      "suggested_key": {
        "default": "Alt+Shift+2"
      },
      "description": "Chuyển sang Account 1 (/u/1)"
    },
    "switch-to-2": {
      "suggested_key": {
        "default": "Alt+Shift+3"
      },
      "description": "Chuyển sang Account 2 (/u/2)"
    },
    "switch-to-3": {
      "suggested_key": {
        "default": "Alt+Shift+4"
      },
      "description": "Chuyển sang Account 3 (/u/3)"
    }
  }
}
