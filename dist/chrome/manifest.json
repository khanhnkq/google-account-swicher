{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "1.2.1",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "tabs",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.google.com/*",
        "https://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_title__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "switch-to-0": {
      "description": "__MSG_shortcutCmd0__",
      "suggested_key": {
        "default": "Alt+Shift+1",
        "mac": "Alt+Shift+1"
      }
    },
    "switch-to-1": {
      "description": "__MSG_shortcutCmd1__",
      "suggested_key": {
        "default": "Alt+Shift+2",
        "mac": "Alt+Shift+2"
      }
    },
    "switch-to-2": {
      "description": "__MSG_shortcutCmd2__",
      "suggested_key": {
        "default": "Alt+Shift+3",
        "mac": "Alt+Shift+3"
      }
    },
    "switch-to-3": {
      "description": "__MSG_shortcutCmd3__",
      "suggested_key": {
        "default": "Alt+Shift+4",
        "mac": "Alt+Shift+4"
      }
    },
    "switch-to-4": {
      "description": "__MSG_shortcutCmd4__"
    },
    "switch-to-5": {
      "description": "__MSG_shortcutCmd5__"
    },
    "switch-to-6": {
      "description": "__MSG_shortcutCmd6__"
    },
    "switch-to-7": {
      "description": "__MSG_shortcutCmd7__"
    },
    "switch-to-8": {
      "description": "__MSG_shortcutCmd8__"
    }
  }
}